# =============================================================================
# Team Portal Lite — Environment Variables
# =============================================================================
# Copy this file to `.env.local` for local development and fill in real values.
# Only variables prefixed with NEXT_PUBLIC_ are exposed to the browser bundle;
# never put secrets (API keys, DB connection strings) behind that prefix.
#
# Three environments are configured separately on Vercel:
#   Production / Preview / Development
# See README.md "部署指南 → 环境变量" for details.
# =============================================================================

# ---------------------------------------------------------------------------
# Client-exposed (safe to ship to the browser).
# ---------------------------------------------------------------------------

# WebSocket server URL used by the real-time notification client.
# When set to a real endpoint, the bell streams live notifications.
# Example (production): wss://ws.team-portal.example.com
# Example (dev):        ws://localhost:8080
NEXT_PUBLIC_WS_URL=

# Simulated real-time notification feed (local dev / demos).
# When NEXT_PUBLIC_WS_URL is empty there is no push server, so a built-in,
# fully client-side mock feed emits "new ticket" alerts (a 2-item burst on
# load, then ~every 12s) so the bell shows live notifications + an unread
# badge in every environment — including the Vercel production demo. It is
# always disabled in CI (Lighthouse). Override with:
#   NEXT_PUBLIC_WS_MOCK=0   -> force off (bell stays empty / disconnected)
#   NEXT_PUBLIC_WS_MOCK=1   -> force on (this is also the default)
NEXT_PUBLIC_WS_MOCK=

# Public base URL of the backend API. Used by TanStack Query fetcher code that
# needs to construct absolute URLs (most calls are relative and reverse-proxied).
# Example: https://api.team-portal.example.com
NEXT_PUBLIC_API_URL=
